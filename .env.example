# Environment variables used by this repository.
#
# This file is the index of what exists and where each value is managed. It is
# not a template to copy to .env for everything: the EDINET prototype's variables
# live in Infisical and are injected at run time.
#
#   infisical run --env=dev -- node prototype/edinet-pit/src/cli.mjs backfill ...
#
# Never commit real values. .env and .env.*.local are already ignored.


# ---------------------------------------------------------------------------
# EDINET PIT prototype  --  managed in Infisical, project "edinet-pit"
# ---------------------------------------------------------------------------
# Set these in Infisical rather than here. Listed so the full surface is visible
# in one place; run `infisical secrets` to see the current values.

# Secret. Issued by EDINET (https://api.edinet-fsa.go.jp/).
# Required by: cli.mjs backfill
EDINET_API_KEY=

# Secret. Issued by the gBizINFO Web API application.
# Do NOT use the demo token published on the Swagger page: it is scoped to that
# page only. Optional -- the coverage script skips its live lookup without it.
GBIZ_API_TOKEN=

# Config. Path to the SQLite store.
# Defaults to ./edinet-pit.db for the CLI, and to an in-memory store seeded from
# fixtures for the MCP server, so the server runs with nothing configured.
EDINET_PIT_DB=

# Config. Path to the raw data lake holding the original document bytes.
# Defaults to ./edinet-pit-lake. Re-normalization reads from here instead of
# re-downloading, so it should point somewhere durable.
EDINET_PIT_LAKE=


# ---------------------------------------------------------------------------
# IE migration VRT server  --  NOT in Infisical
# ---------------------------------------------------------------------------
# None of these are secrets; they are behavioural switches and paths set per run
# or per machine. Putting non-secrets in a secret store buries the real secrets,
# so they are documented here and left to the environment.

# Screenshot comparison, set by the server when it invokes Playwright.
MCP_VRT_RUN_DIR=
MCP_VRT_ACTUAL_PATH=
MCP_VRT_MAX_DIFF_PIXEL_RATIO=0.005
MCP_VRT_THRESHOLD=0.2

# Selenium / IE mode.
MCP_SELENIUM_ALLOW_UNSAFE_BROWSER_ARGS=
MCP_IE_DRIVER_LOG=

# Tests.
MCP_DEBUG=
MCP_SELENIUM_TEST_BROWSER=
SAFARI_AVAILABLE=
CHROME_BIN=

# Windows VRT smoke script.
VRT_SMOKE_URL=http://localhost:8088/Default.aspx
VRT_SMOKE_OUTPUT=C:\vrt-lab\smoke-result.json
VRT_SMOKE_ARTIFACT_DIR=C:\vrt-lab\artifacts
VRT_SMOKE_WIDTH=1200
VRT_SMOKE_HEIGHT=650
